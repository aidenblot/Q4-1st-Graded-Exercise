<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="author" content="Aiden Baltazar" />
    <meta name="description" content="Answering forms" />
    <meta
      name="keywords"
      content="PSHS-MC, CS3, Q1W2, JavaScript, Forms, Meta, Favicon"
    />
    <title>Baltazar - CS 3</title>
    <title>Happy Birthday Song Generator</title>
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
   <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="w3-container">
        <h1>Happy Birthday Song Generator</h1>
        <form action="/happy" method="POST">
            <label for="celebrant">Celebrant's Name:</label>
            <input type="text" id="celebrant" name="celebrant" required>
            <label for="gender">Gender:</label>
            <select id="gender" name="gender" required>
                <option value="male">Male</option>
                <option value="female">Female</option>
            </select>
            <label for="guests">Guests' Names (comma-separated):</label>
            <input type="text" id="guests" name="guests" required>
            <button type="submit">Generate Song</button>
        </form>
    </div>
</body>
</html>
